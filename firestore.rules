rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Products Collection: Publicly readable for all visitors on web and mobile
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Settings Collection: Publicly readable for all visitors
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Default deny catch-all for any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
